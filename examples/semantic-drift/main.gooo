@gooo schema="gooo/semantic-drift/v1"
protocol semantic-drift-v1 denominator="gooo/semantic-drift/denominator-v1"

activity id="gooo://semantic-drift/activity/syntax-add" activity="SyntaxAdd" name="Syntax denominator add" dimension="SYNTAX_DENOMINATOR" step="CLASSIFY_ADD" artifact="drift_manifest.denominator.events" evaluator="drift.Evaluate"
activity id="gooo://semantic-drift/activity/syntax-retire" activity="SyntaxRetire" name="Syntax denominator retire" dimension="SYNTAX_DENOMINATOR" step="CLASSIFY_RETIRE" artifact="drift_manifest.denominator.events" evaluator="drift.Evaluate"
activity id="gooo://semantic-drift/activity/syntax-split" activity="SyntaxSplit" name="Syntax denominator split" dimension="SYNTAX_DENOMINATOR" step="CLASSIFY_SPLIT" artifact="drift_manifest.denominator.events" evaluator="drift.Evaluate"
activity id="gooo://semantic-drift/activity/schema-compatibility" activity="SchemaCompatibility" name="Schema compatibility" dimension="SCHEMA_MIGRATION" step="COMPARE_SCHEMA_FINGERPRINTS" artifact="drift_manifest.schema" evaluator="drift.Evaluate"
activity id="gooo://semantic-drift/activity/schema-migration" activity="SchemaMigration" name="Explicit schema migration" dimension="SCHEMA_MIGRATION" step="REQUIRE_EXPLICIT_MIGRATION" artifact="causal_evidence.events" evaluator="drift.Evaluate"
activity id="gooo://semantic-drift/activity/lowering-identity-binding" activity="LoweringIdentityBinding" name="Lowering identity binding" dimension="LOWERING_IDENTITY" step="COMPARE_EXPLICIT_IDENTITIES" artifact="drift_manifest.lowering" evaluator="drift.Evaluate"
activity id="gooo://semantic-drift/activity/lowering-identity-drift" activity="LoweringIdentityDrift" name="Lowering identity drift" dimension="LOWERING_IDENTITY" step="REJECT_INFERRED_IDENTITY" artifact="decision_receipt.contradictions" evaluator="drift.Evaluate"
activity id="gooo://semantic-drift/activity/artifact-manifest" activity="ArtifactManifest" name="Generated artifact manifest" dimension="GENERATED_ARTIFACT" step="COMPARE_ARTIFACT_DIGESTS" artifact="drift_manifest.generated_artifacts" evaluator="drift.Evaluate"
activity id="gooo://semantic-drift/activity/artifact-change" activity="ArtifactChange" name="Generated artifact change" dimension="GENERATED_ARTIFACT" step="BIND_ARTIFACT_CHANGE" artifact="causal_evidence.events" evaluator="drift.Evaluate"
activity id="gooo://semantic-drift/activity/input-binding" activity="InputBinding" name="Replay input binding" dimension="OBSERVABLE_BEHAVIOR" step="BIND_REPLAY_INPUTS" artifact="replay_receipt.observations" evaluator="drift.Evaluate"
activity id="gooo://semantic-drift/activity/replay-equivalence" activity="ReplayEquivalence" name="Replay equivalence" dimension="OBSERVABLE_BEHAVIOR" step="COMPARE_REPLAYED_VALUES" artifact="replay_receipt.counts" evaluator="drift.Evaluate"
activity id="gooo://semantic-drift/activity/behavior-contradiction" activity="BehaviorContradiction" name="Observable behavior contradiction" dimension="OBSERVABLE_BEHAVIOR" step="REFUTE_CONTRADICTORY_VALUE" artifact="decision_receipt.contradictions" evaluator="drift.Evaluate"
activity id="gooo://semantic-drift/activity/immutable-envelope" activity="ImmutableEnvelope" name="Immutable envelope binding" dimension="AUTHORITY" step="VERIFY_RELEASE_DIGEST" artifact="drift_manifest.envelopes" evaluator="drift.Evaluate"
activity id="gooo://semantic-drift/activity/state-precedence" activity="StatePrecedence" name="Decision precedence" dimension="AUTHORITY" step="RESOLVE_REFUTED_UNKNOWN_CLOSED" artifact="decision_receipt.state" evaluator="drift.Evaluate"
activity id="gooo://semantic-drift/activity/human-receipt" activity="HumanReceipt" name="Human report receipt" dimension="REPORTING" step="RENDER_HUMAN_REPORT" artifact="human_report.md" evaluator="drift.HumanReport"
